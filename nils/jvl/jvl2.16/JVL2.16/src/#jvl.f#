c      lppar(ippsi ) = .true.

c      lppar(ipmach) = .true.
      lppar(ipvee ) = .true.
      lppar(iprho ) = .true.
c      lppar(ipgee ) = .true.

      lppar(iprad ) = .true.
c      lppar(ipfac ) = .true.

      lppar(ipxcg ) = .true.
c      lppar(ipycg ) = .true.
      lppar(ipzcg ) = .true.

